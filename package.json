{
  "name": "studypal-reels",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/compositions/Root.tsx",
    "render:batch": "tsx src/render/renderBatch.ts",
    "data:export-sample": "tsx src/data/exportSample.ts",
    "prisma:pull": "prisma db pull",
    "prisma:generate": "prisma generate",
    "gui:server": "tsx watch server/index.ts",
    "gui:dev": "vite --config gui/vite.config.ts",
    "gui:build": "vite build --config gui/vite.config.ts",
    "gui": "concurrently -n server,gui -c blue,magenta \"npm:gui:server\" \"npm:gui:dev\""
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@remotion/bundler": "4.0.523",
    "@remotion/cli": "4.0.523",
    "@remotion/fonts": "4.0.523",
    "@remotion/google-fonts": "4.0.523",
    "@remotion/player": "4.0.523",
    "@remotion/renderer": "4.0.523",
    "@remotion/transitions": "4.0.523",
    "better-sqlite3": "^11.8.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "microsoft-cognitiveservices-speech-sdk": "^1.42.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.0",
    "remotion": "4.0.523",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
