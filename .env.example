DATABASE_URL=postgresql://studypal:devpassword@localhost:5433/studypal
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus

# GUI: Facebook Page publishing (Settings page's "Connect with Facebook") -
# create a Meta app at https://developers.facebook.com/apps, add "Facebook
# Login for Business", and set its Valid OAuth Redirect URI to
# http://localhost:4300/api/facebook/callback (or match FACEBOOK_REDIRECT_URI
# below if you change the server port) - see docs/ARCHITECTURE.md.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:4300/api/facebook/callback
# Required for Page permissions on newer apps - Facebook Login for Business ->
# Configurations -> New (asset type "Pages", check pages_show_list/
# pages_read_engagement/pages_manage_posts), then paste that Configuration's
# id here. Without it, the OAuth dialog rejects those scopes outright.
FACEBOOK_CONFIG_ID=
