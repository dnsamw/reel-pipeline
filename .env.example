DATABASE_URL=postgresql://studypal:devpassword@localhost:5433/studypal
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus

# GUI: Facebook Page publishing (Settings page's "Connect with Facebook") -
# create a Meta app at https://developers.facebook.com/apps, add "Facebook
# Login for Business", and set its Valid OAuth Redirect URI to
# http://localhost:4300/api/facebook/callback (or match FACEBOOK_REDIRECT_URI
# below if you change the server port) - see docs/ARCHITECTURE.md.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:4300/api/facebook/callback
# Required for Page permissions on newer apps - Facebook Login for Business ->
# Configurations -> New (asset type "Pages", check pages_show_list/
# pages_read_engagement/pages_manage_posts), then paste that Configuration's
# id here. Without it, the OAuth dialog rejects those scopes outright.
FACEBOOK_CONFIG_ID=

# Optional AI helper (NVIDIA's hosted API - https://build.nvidia.com). Only
# adds a "Write with AI" button to the Publish panel's captions; everything
# works without it (built-in caption writer), and an expired/missing key just
# falls back to that. NVIDIA_MODEL defaults to moonshotai/kimi-k3.
NVIDIA_API_KEY=
NVIDIA_MODEL=

# YouTube publishing (Settings → Connected accounts → YouTube). A Google Cloud
# OAuth client of type "Desktop app" with the YouTube Data API v3 enabled - the
# login redirects to http://127.0.0.1:<server port>/api/youtube/callback, which
# Desktop clients allow without registering it. Until the project passes
# YouTube's API audit, uploads are forced to Private.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# TikTok publishing (Settings → Connected accounts → TikTok): a TikTok developer
# app with Login Kit (platform: Desktop) + Content Posting API (Upload), scopes
# user.info.basic + video.upload, and the redirect URI
# http://127.0.0.1:*/api/tiktok/callback/ registered. Uploads land in your
# TikTok drafts; you finish and post them in the TikTok app.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
